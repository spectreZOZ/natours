{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "type": "commonjs",
  "main": "app.js",
  "bundle": "./public/js/bundle.js",
  "targets": {
    "bundle": {
      "isLibrary": false,
      "context": "browser",
      "outputFormat": "global"
    }
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "cross-env NODE_ENV=production nodemon server.js",
    "debug": "nodemon --inspect server.js",
    "watch:js": "parcel watch ./public/js/index.js --target bundle",
    "build:js": "parcel build ./public/js/index.js --target bundle"
  },
  "author": "Ziad ahmed",
  "license": "ISC",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^6.13.8",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pug": "^3.0.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "stripe": "^23.2.0",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=10.0.0"
  }
}
